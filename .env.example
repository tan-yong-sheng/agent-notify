# ─── Notification channels ───────────────────────────────────────────────────
# Enable or disable each channel independently.
# Default: desktop on, ntfy off (no ntfy setup needed).
PLATFORM_DESKTOP=true
PLATFORM_NTFY=false

# ─── ntfy settings (only used when PLATFORM_NTFY=true) ───────────────────────
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=agent-alerts
NTFY_API_KEY=

# ntfy priority levels (1-5; 1=min, 5=max)
NTFY_PRIORITY_DONE=4
NTFY_PRIORITY_BLOCKED=5

# ─── Dashboard settings ───────────────────────────────────────────────────────
# Local web dashboard port (defaults to 3333)
DASHBOARD_PORT=3333
